# ORTHRUS environment - copy this file to `.env` and fill in your values.
# `.env` is gitignored, so your keys never get committed.
# VS Code's Python extension reads this for the DEBUGGER (python.envFile). ORTHRUS's
# CLI reads os.environ, so for terminal runs either set the vars in the terminal
# (see docs/BOUNTY_WORKFLOW.md) or dot-source them once per session.

# ---------------------------------------------------------------- LLM (AI reports)
# Used by `orthrus ai-report` and `orthrus bounty --llm ...`.
# Universal key - takes priority for ANY provider:
ORTHRUS_LLM_API_KEY=

# Custom OpenAI-compatible endpoint (NVIDIA NIM / Azure / Groq / vLLM / LM Studio ...).
# For NVIDIA NIM (nvapi- key), use:
# ORTHRUS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-call timeout in seconds (raise for big/cold hosted models; default 180):
# ORTHRUS_LLM_TIMEOUT=300

# Provider-specific fallbacks (only used if ORTHRUS_LLM_API_KEY is empty):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------ storage / platform
# Where the operator graph + scans live (default: local sqlite in ORTHRUS_HOME):
# ORTHRUS_DB_URL=sqlite+aiosqlite:///orthrus.db
# Where bounty JSON stores live (programs, submissions, notes):
# ORTHRUS_HOME=

# Gate REST mutations / turn on team RBAC (leave empty for single-user local):
# ORTHRUS_API_TOKEN=
