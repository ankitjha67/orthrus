{
  "name": "reflecting-target",
  "description": "Ground truth for tests/integration/reflecting_target.py — an intentionally-vulnerable app ORTHRUS owns. Each entry maps a known vuln class to the route/param that exhibits it. 'optional' marks vulns needing a deferred capability (a real Playwright browser, a websockets server, or spec --import to annotate REST path ids) and so are tracked but excluded from the headline detection rate. Out-of-band classes (SSRF) need the callback server, i.e. run with --confirm.",
  "target": "http://127.0.0.1:8731/",
  "expected": [
    {"vuln_type": "xss", "url_contains": "/search", "param": "q", "note": "reflected XSS in query param"},
    {"vuln_type": "xss", "url_contains": "/render", "param": "name", "note": "reflected XSS (unencoded greeting)"},
    {"vuln_type": "xss", "url_contains": "/ping", "param": "host", "note": "reflected XSS (unencoded ping result)"},
    {"vuln_type": "xss", "url_contains": "/profile", "param": "id", "note": "reflected XSS (unencoded profile body)"},
    {"vuln_type": "xss", "url_contains": "/comment", "param": "text", "note": "reflected XSS in POST body"},
    {"vuln_type": "sqli", "url_contains": "/sqli", "param": "id", "note": "MySQL error-based SQLi"},
    {"vuln_type": "ssti", "url_contains": "/render", "param": "name", "note": "server-side template eval of a*b"},
    {"vuln_type": "cmd-injection", "url_contains": "/ping", "param": "host", "note": "OS command injection (echo marker)"},
    {"vuln_type": "lfi", "url_contains": "/download", "param": "file", "note": "local file inclusion (/etc/passwd, win.ini)"},
    {"vuln_type": "ssrf", "url_contains": "/fetch", "param": "url", "note": "server-side request forgery — OOB, needs --confirm"},
    {"vuln_type": "open-redirect", "url_contains": "/redirect", "param": "url", "note": "unvalidated redirect via Location"},
    {"vuln_type": "xxe", "url_contains": "/xml", "note": "in-band XXE file read on POSTed XML"},
    {"vuln_type": "idor", "url_contains": "/profile", "param": "id", "note": "object enumeration via numeric id"},
    {"vuln_type": "graphql", "url_contains": "/graphql", "note": "introspection enabled"},
