    {"vuln_type": "cors", "url_contains": "", "note": "reflects arbitrary Origin with credentials"},
    {"vuln_type": "csrf", "url_contains": "", "note": "state-changing forms with no anti-CSRF token"},
    {"vuln_type": "default-creds", "url_contains": "/login", "note": "admin/admin accepted"},
    {"vuln_type": "security-headers", "url_contains": "", "note": "missing CSP/HSTS/X-Frame-Options etc."},
    {"vuln_type": "auth-session", "url_contains": "", "note": "cookies lack HttpOnly/Secure/SameSite flags"},
    {"vuln_type": "deserialization", "url_contains": "", "note": "PHP-serialized object in a cookie"},
    {"vuln_type": "jwt", "url_contains": "", "note": "JWT signed with the weak secret 'secret'"},
    {"vuln_type": "exposed-file", "url_contains": "/.env", "note": "sensitive dotfile served"},
    {"vuln_type": "exposed-file", "url_contains": "/.git/HEAD", "note": "exposed VCS metadata"},
    {"vuln_type": "mass-assignment", "url_contains": "/api/account", "note": "autobinds arbitrary privileged fields (role/is_admin/...)"},

    {"vuln_type": "idor", "url_contains": "/api/users", "param": "id", "note": "BOLA via REST path id — needs spec --import to annotate", "optional": true},
    {"vuln_type": "xss", "url_contains": "/dom", "note": "DOM XSS via innerHTML — needs a real browser", "optional": true},
    {"vuln_type": "xss", "url_contains": "/guestbook", "note": "stored XSS via guestbook", "optional": true},
