{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORTHRUS Cockpit",
  "version": "2.0.0",
  "identifier": "com.ankitjha67.orthrus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ORTHRUS Cockpit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
