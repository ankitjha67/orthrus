# Slim ORTHRUS image - core + scanners + API/dashboard, no headless browser.
# Much smaller/faster to pull than docker/Dockerfile (which bundles Chromium for
# the DOM/browser scanners). Browser-based scanners self-disable when Playwright
# is absent, so the full recon → scan → confirm → report pipeline still runs.
#
#   docker run --rm ghcr.io/ankitjha67/orthrus --help
#   docker run --rm ghcr.io/ankitjha67/orthrus scan -t http://TARGET --scope TARGET
#   docker run --rm -p 8000:8000 ghcr.io/ankitjha67/orthrus serve --host 0.0.0.0
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nmap ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY orthrus ./orthrus

RUN pip install --no-cache-dir -e ".[scanners,api,mcp]"

EXPOSE 8000
ENTRYPOINT ["orthrus"]
CMD ["--help"]
