{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ORTHRUS",
          "informationUri": "https://github.com/anthropics/orthrus",
          "version": "0.1.0",
          "rules": [
            {
              "id": "cmd-injection",
              "name": "CmdInjection",
              "shortDescription": {
                "text": "OS command injection (output-based) in 'host'"
              },
              "fullDescription": {
                "text": "Parameter 'host' is passed to an OS shell; an injected echo command executed and its output was returned. This is remote code execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-78",
                  "A03:2021 - Injection"
                ],
                "security-severity": "9.8"
              }
            },
            {
              "id": "graphql-injection",
              "name": "GraphqlInjection",
              "shortDescription": {
                "text": "OS command injection in GraphQL argument 'systemDiagnostics.cmd'"
              },
              "fullDescription": {
                "text": "A shell metacharacter + canary injected into the GraphQL argument 'cmd' of 'mutation systemDiagnostics' was executed — the canary was echoed back by the OS shell, proving arbitrary command execution via a GraphQL resolver."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-78",
                  "A03:2021 - Injection"
                ],
                "security-severity": "9.8"
              }
            },
            {
              "id": "file-upload",
              "name": "FileUpload",
              "shortDescription": {
                "text": "Unrestricted file upload (.php accepted) at /upload"
              },
              "fullDescription": {
                "text": "The upload endpoint /upload accepted a file with a dangerous '.php' extension. If uploaded files are served from the web root or interpreted by the server, an attacker can upload a web shell (RCE) or a .svg/.html for stored XSS. The probe uploaded a harmless inert marker, not a working payload — confirm where the file lands and whether it executes."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-434",
                  "A04:2021 - Insecure Design"
                ],
                "security-severity": "8.8"
              }
            },
            {
              "id": "prompt-injection",
              "name": "PromptInjection",
              "shortDescription": {
                "text": "LLM prompt injection via 'message' (instructions overridden)"
              },
              "fullDescription": {
                "text": "An injected instruction sent through 'message' caused the model to ignore its system/developer prompt and emit an attacker-chosen canary token verbatim (OWASP LLM01). An attacker can hijack the model to exfiltrate data, call tools/functions, produce harmful output, or bypass guardrails."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1427",
                  "A03:2021 - Injection"
                ],
                "security-severity": "8.2"
              }
            },
            {
              "id": "default-creds",
              "name": "DefaultCreds",
              "shortDescription": {
                "text": "Default credentials accepted: admin/admin"
              },
              "fullDescription": {
                "text": "The login form accepted default credentials 'admin:admin', granting access."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1392",
                  "A07:2021 - Identification and Authentication Failures"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "xss",
              "name": "Xss",
              "shortDescription": {
                "text": "DOM-based XSS: URL-controlled value flows into innerHTML()"
              },
              "fullDescription": {
                "text": "A value taken from the page URL reached the JavaScript sink 'innerHTML', which renders/executes its argument. Attacker-controlled URL data flowing into this sink is DOM-based cross-site scripting — exploited entirely client-side, so the server (and server-side filters) never see the payload."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-79",
                  "A03:2021 - Injection"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "sqli",
              "name": "Sqli",
              "shortDescription": {
                "text": "SQL injection (error-based, MySQL) in parameter 'id'"
              },
              "fullDescription": {
                "text": "Parameter 'id' appears injectable via error-based injection. An attacker may be able to read or modify database contents."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-89",
                  "A03:2021 - Injection"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "jwt",
              "name": "Jwt",
              "shortDescription": {
                "text": "JWT header references an external key URL ('jku')"
              },
              "fullDescription": {
                "text": "The token header sets 'jku'='https://attacker.example/jwks.json'. If the server fetches its verification key from this URL without a strict allow-list, an attacker can serve their own key (or point it at an internal host for SSRF) and forge tokens. (token: eyJhbGciOiAiUlMyNTYiLCAi...)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-347",
                  "A07:2021 - Identification and Authentication Failures"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "mass-assignment",
              "name": "MassAssignment",
              "shortDescription": {
                "text": "Mass assignment: server bound unexpected field(s) on POST request"
              },
              "fullDescription": {
                "text": "The endpoint incorporated attacker-supplied privileged field(s) [account_balance, active, admin, approved, balance, credit, email_verified, enabled, grants, group, group_id, isAdmin, is_active, is_admin, is_staff, is_superuser, is_verified, owner_id, permissions, role, roles, scopes, user_id, verified] into its response object even though they were not part of the documented request. This indicates the request body is bound directly to an internal model (mass assignment / autobinding), allowing a client to set server-controlled properties. Confirm whether the bound values are persisted/honored downstream."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-915"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "nosql-injection",
              "name": "NosqlInjection",
              "shortDescription": {
                "text": "NoSQL injection (error-based) in 'user'"
              },
              "fullDescription": {
                "text": "The parameter 'user' reflected a NoSQL driver error when sent a query-breaking payload. This indicates user input is concatenated into a NoSQL query (e.g. MongoDB), allowing authentication bypass, data exfiltration via operator injection ($ne/$gt/$regex), or $where JavaScript execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-943",
                  "A03:2021 - Injection"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "ssti",
              "name": "Ssti",
              "shortDescription": {
                "text": "Server-side template injection (Jinja2/Twig) in 'name'"
              },
              "fullDescription": {
                "text": "Parameter 'name' is evaluated by a server-side template engine (Jinja2/Twig): the expression 5082*3869 returned 19662258. SSTI commonly leads to remote code execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1336",
                  "A03:2021 - Injection"
                ],
                "security-severity": "8.1"
              }
            },
            {
              "id": "prototype-pollution",
              "name": "PrototypePollution",
              "shortDescription": {
                "text": "Client-side prototype pollution"
              },
              "fullDescription": {
                "text": "A payload polluted Object.prototype in the browser (Object.prototype.hpp1f3780 === '841bf610'). A vulnerable client-side merge can be abused for DOM XSS, auth bypass, or RCE in gadgets."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1321",
                  "A08:2021 - Software and Data Integrity Failures"
                ],
                "security-severity": "7.7"
              }
            },
            {
              "id": "cors",
              "name": "Cors",
              "shortDescription": {
                "text": "CORS misconfiguration: reflects an arbitrary request Origin with credentials allowed"
              },
              "fullDescription": {
                "text": "The endpoint reflects an arbitrary request Origin with credentials allowed. An attacker-controlled site could send cross-origin requests and read the responses, exposing data of authenticated users when credentials are allowed."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-942",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "exposed-file",
              "name": "ExposedFile",
              "shortDescription": {
                "text": "Exposed sensitive file: /.env"
              },
              "fullDescription": {
                "text": "The sensitive file /.env is publicly accessible (HTTP 200). It may expose credentials, source code, or internal configuration."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-538",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "framework-debug",
              "name": "FrameworkDebug",
              "shortDescription": {
                "text": "Exposed framework/management endpoint: Spring Boot Actuator (env) (/actuator/env)"
              },
              "fullDescription": {
                "text": "The Spring Boot Actuator (env) endpoint at /actuator/env is publicly reachable and returned its expected content. Management and framework endpoints commonly expose configuration, environment variables and secrets, runtime metrics, request history, or internal routes — valuable reconnaissance and, for some (e.g. Actuator env/heapdump), a direct path to credential disclosure or RCE."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-200",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "lfi",
              "name": "Lfi",
              "shortDescription": {
                "text": "Local file inclusion / path traversal in 'file'"
              },
              "fullDescription": {
                "text": "Parameter 'file' allows reading arbitrary files; the contents of /etc/passwd were returned. This can expose credentials, source code, and configuration."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-22",
                  "A03:2021 - Injection"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "exposed-secret",
              "name": "ExposedSecret",
              "shortDescription": {
                "text": "Exposed secret: AWS access key"
              },
              "fullDescription": {
                "text": "A AWS access key appears to be exposed in the response served at http://127.0.0.1:8791/app.js. Secrets embedded in HTML, inline JavaScript, or JSON responses are trivially harvested by anyone who loads the page and can grant direct access to cloud accounts, third-party APIs, source repositories, or payment systems."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-798",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "ssrf",
              "name": "Ssrf",
              "shortDescription": {
                "text": "Server-side request forgery via 'url' (out-of-band)"
              },
              "fullDescription": {
                "text": "The server fetched an attacker-supplied URL placed in 'url'. The callback server received a HTTP request from 127.0.0.1. SSRF can reach internal services and cloud metadata."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-918",
                  "A10:2021 - Server-Side Request Forgery"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "xxe",
              "name": "Xxe",
              "shortDescription": {
                "text": "XML external entity (XXE) injection"
              },
              "fullDescription": {
                "text": "The XML parser resolved an external entity and returned the contents of /etc/passwd. XXE can lead to file disclosure, SSRF, and DoS."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-611",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "crlf-injection",
              "name": "CrlfInjection",
              "shortDescription": {
                "text": "CRLF injection / HTTP response splitting in 'url'"
              },
              "fullDescription": {
                "text": "A CRLF sequence injected via 'url' produced an attacker-controlled response header (a sentinel header and Set-Cookie appeared in the response). This HTTP response splitting enables session fixation, cache poisoning, and reflected XSS by smuggling headers or a second response body."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-113",
                  "A03:2021 - Injection"
                ],
                "security-severity": "6.5"
              }
            },
            {
              "id": "csrf",
              "name": "Csrf",
              "shortDescription": {
                "text": "POST form without anti-CSRF token"
              },
              "fullDescription": {
                "text": "A state-changing POST form was found with no recognizable anti-CSRF token field (fields: text, email). If the session relies on cookies without SameSite protection, the action may be forgeable cross-site."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-352",
                  "A01:2021 - Broken Access Control"
                ],
                "security-severity": "6.5"
              }
            },
            {
              "id": "idor",
              "name": "Idor",
              "shortDescription": {
                "text": "Possible IDOR / object enumeration via 'id'"
              },
              "fullDescription": {
                "text": "Changing the numeric reference 'id' from 1 to 2 returned a different valid object. If access control is not enforced per object, this exposes other users' data. Manual authorization review required."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-639",
                  "A01:2021 - Broken Access Control"
                ],
                "security-severity": "6.5"
              }
            },
            {
              "id": "web-cache-deception",
              "name": "WebCacheDeception",
              "shortDescription": {
                "text": "Web cache deception: dynamic page served at a static URL (/account/orthrus-wcd-f3d751.css)"
              },
              "fullDescription": {
                "text": "Appending '/<file>.css' to /account returned the original dynamic page verbatim instead of a 404. A CDN or proxy that caches by file extension can then store this 'static' response and serve one user's private content to others. The response carries cache indicators."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-525",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "5.9"
              }
            },
            {
              "id": "cache-poisoning",
              "name": "CachePoisoning",
              "shortDescription": {
                "text": "Unkeyed header reflected (web cache poisoning candidate)"
              },
              "fullDescription": {
                "text": "An unkeyed request header (e.g. X-Forwarded-Host) is reflected into the response and the response shows cache indicators. If this response is cached, an attacker can poison it for other users."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-444",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "5.6"
              }
            },
            {
              "id": "auth-session",
              "name": "AuthSession",
              "shortDescription": {
                "text": "Low-entropy session token ('sid')"
              },
              "fullDescription": {
                "text": "The session token 'sid' has ~43 bits of entropy (< 64), making it potentially predictable/brute-forceable."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-331",
                  "A07:2021 - Identification and Authentication Failures"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "deserialization",
              "name": "Deserialization",
              "shortDescription": {
                "text": "Serialized object in cookie 'obj' (PHP serialized object)"
              },
              "fullDescription": {
                "text": "A PHP serialized object appears in a user-controllable cookie 'obj'. If deserialized without integrity checks, this can lead to remote code execution via gadget chains."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-502",
                  "A08:2021 - Software and Data Integrity Failures"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "graphql-dos",
              "name": "GraphqlDos",
              "shortDescription": {
                "text": "GraphQL query batching enabled"
              },
              "fullDescription": {
                "text": "The endpoint accepted a JSON array of operations and returned an array of results. Batching lets an attacker pack many operations into one request — amplifying rate-limited actions (e.g. login/OTP brute-force) and resource use."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-770",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "security-headers",
              "name": "SecurityHeaders",
              "shortDescription": {
                "text": "Missing Content-Security-Policy header"
              },
              "fullDescription": {
                "text": "No Content-Security-Policy header is set, removing a key defense against cross-site scripting and data injection."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-693",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "llm-info-disclosure",
              "name": "LlmInfoDisclosure",
              "shortDescription": {
                "text": "LLM system-prompt / sensitive-info disclosure via 'message'"
              },
              "fullDescription": {
                "text": "Asking the model (via 'message') to repeat its instructions returned text that reads like a leaked system prompt (OWASP LLM06). Leaked system prompts expose hidden rules, embedded secrets/keys, and tool definitions that aid further attacks. Confirm manually that the disclosed text is the real system prompt."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-200",
                  "A04:2021 - Insecure Design"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "oauth-misconfig",
              "name": "OauthMisconfig",
              "shortDescription": {
                "text": "OAuth authorization request without 'state' (CSRF)"
              },
              "fullDescription": {
                "text": "No 'state' parameter is present, so the authorization response is not bound to the user's session — enabling login CSRF / authorization-code injection."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-352",
                  "A07:2021 - Identification and Authentication Failures"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "graphql",
              "name": "Graphql",
              "shortDescription": {
                "text": "GraphQL introspection enabled"
              },
              "fullDescription": {
                "text": "The GraphQL endpoint answered an introspection query, exposing its full schema (types, queries, mutations). This aids attackers in mapping the API."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-200",
                  "A05:2021 - Security Misconfiguration"
                ],
                "security-severity": "5.3"
              }
            },
            {
              "id": "open-redirect",
              "name": "OpenRedirect",
              "shortDescription": {
                "text": "Open redirect via parameter 'url'"
              },
              "fullDescription": {
                "text": "Parameter 'url' controls the redirect target. The server redirected to the attacker-controlled host via Location: https://orthrus-redirect.example/. This enables phishing and OAuth token theft."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-601",
                  "A01:2021 - Broken Access Control"
                ],
                "security-severity": "4.7"
              }
            },
            {
              "id": "host-header-injection",
              "name": "HostHeaderInjection",
              "shortDescription": {
                "text": "Host header injection (attacker-controlled host reflected into links/redirects)"
              },
              "fullDescription": {
                "text": "A sentinel host sent in the 'Host'/'X-Forwarded-Host' request header was reflected back into an absolute URL in the body. When the application builds absolute URLs (password-reset and email-confirmation links, redirects, or script/link src) from the incoming host header, an attacker can set it to a domain they control. A victim who clicks the resulting link — e.g. a poisoned password-reset email — leaks the secret token to the attacker (account takeover); the same primitive enables web-cache poisoning and, where the host selects an upstream, SSRF."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-644",
                  "A03:2021 - Injection"
                ],
                "security-severity": "4.2"
              }
            },
            {
              "id": "vulnerable-component",
              "name": "VulnerableComponent",
              "shortDescription": {
                "text": "Outdated/vulnerable JS library: jQuery 1.7.1"
              },
              "fullDescription": {
                "text": "http://127.0.0.1:8791/app.js bundles jQuery 1.7.1. jQuery < 3.5.0 is vulnerable to XSS via htmlPrefilter (CVE-2020-11022 / CVE-2020-11023). Client-side libraries with known vulnerabilities expose users to XSS, prototype pollution, and other client-side attacks."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-79",
                  "A06:2021 - Vulnerable and Outdated Components"
                ],
                "security-severity": "4.2"
              }
            },
            {
              "id": "parameter-pollution",
              "name": "ParameterPollution",
              "shortDescription": {
                "text": "HTTP parameter pollution: duplicate 'q' silently dropped"
              },
              "fullDescription": {
                "text": "Sending 'q' twice in one query string caused the server to keep only the first occurrence and discard the other. When a security control (WAF rule, authorization filter, or input validator) inspects the discarded copy while application code reads the surviving one, an attacker can smuggle a malicious value past the control via the dropped duplicate."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-235",
                  "A03:2021 - Injection"
                ],
                "security-severity": "3.1"
              }
            },
            {
              "id": "example",
              "name": "Example",
              "shortDescription": {
                "text": "Server banner disclosed: BaseHTTP/0.6 Python/3.14.5"
              },
              "fullDescription": {
                "text": "Example plugin: the Server header advertises 'BaseHTTP/0.6 Python/3.14.5'."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-200",
